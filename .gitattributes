# Keep source checks and generated text stable across Windows and Unix checkouts.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary

# Byte-for-byte fixtures from preview.20; their published digests must survive checkout.
scripts/fixtures/library-preview20/library.sqlite binary
scripts/fixtures/library-preview20/backup.json -text

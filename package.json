{
  "name": "novel-director",
  "version": "0.1.6-preview.18",
  "productName": "Novel Director",
  "description": "AI long-form novel creation management desktop MVP",
  "license": "MIT",
  "author": "Novel Director contributors",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "dist:win": "node scripts/run-dist-win.mjs",
    "smoke": "node scripts/run-smoke-preview.mjs",
    "smoke:packaged": "node scripts/smoke-packaged-app.mjs",
    "smoke:release": "node scripts/smoke-packaged-app.mjs release",
    "rc:fixture": "node scripts/rc-regression.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:single": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "electron-vite preview",
    "qa:hig": "node scripts/qa-hig-workspace.mjs",
    "preview:sqlite": "npm run build && npm run native:electron && electron-vite preview",
    "native:electron": "node scripts/manage-sqlite-native.mjs electron",
    "native:node": "node scripts/manage-sqlite-native.mjs node",
    "native:check:electron": "node scripts/manage-sqlite-native.mjs check-electron",
    "native:check:node": "node scripts/manage-sqlite-native.mjs check-node",
    "agent": "node scripts/run-agent.mjs",
    "agent:tools": "node scripts/run-agent-tools.mjs",
    "agent:setup:codex": "node scripts/setup-codex-mcp.mjs",
    "agent:check:codex": "node scripts/setup-codex-mcp.mjs --check",
    "perf:novelty": "node scripts/benchmark-novelty-audit.mjs --output tmp/performance/novelty-audit.json",
    "perf:ui": "node scripts/benchmark-production-ui.mjs --output tmp/performance/production-ui.json",
    "perf:prompt": "node scripts/benchmark-prompt-composition.mjs --output tmp/performance/prompt-composition.json",
    "perf:post-draft": "node scripts/benchmark-post-draft-analysis.mjs --output tmp/performance/post-draft-analysis.json",
    "perf:storage": "node scripts/benchmark-long-novel-storage.mjs",
    "perf:backend": "node scripts/benchmark-backend-checkpoints.mjs",
    "perf:agent-overview": "node scripts/benchmark-agent-overview.mjs",
    "compare:prepare": "node scripts/prepare-model-comparison.mjs",
    "perf:long-ui": "node scripts/benchmark-long-novel-ui.mjs",
    "perf:accepted-cost": "node scripts/benchmark-accepted-chapter-cost.mjs --output tmp/performance/accepted-chapter-cost.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "better-sqlite3": "^12.9.0",
    "electron-vite": "^4.0.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "build": {
    "appId": "com.noveldirector.workbench",
    "productName": "Novel Director",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "README.md"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Novel Director",
      "deleteAppDataOnUninstall": false
    }
  }
}
